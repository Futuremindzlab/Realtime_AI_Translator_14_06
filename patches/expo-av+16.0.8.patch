+    // Patched (see patches/expo-av+16.0.8.patch and services/audioService.ts):
+    // AudioSource.DEFAULT applies no noise suppression, so ambient noise
+    // reaches Whisper and can make it garble real speech. VOICE_COMMUNICATION
+    // is the source Android attaches its noise suppressor, echo canceller and
+    // AGC to. (VOICE_RECOGNITION was tried first, but Android requires all
+    // pre-processing to be OFF for that source: no noise suppression and no
+    // AGC, so it only made capture quieter -- the likely cause of the
+    // "No input from Person A" turns seen on build 60c5bc8. See
+    // source.android.com/docs/core/audio/implement-pre-processing.)
+    mAudioRecorder.setAudioSource(MediaRecorder.AudioSource.VOICE_COMMUNICATION);
 
